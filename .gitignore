# secrets
.env
*.env
!.env.example

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.mypy_cache/
.import_linter_cache/

# frontend build output (rebuilt inside the Docker image)
frontend/dist/

# eval logs; the recordings under evals/runs are committed on purpose, they are the evidence
# behind evals/REPORT.md and can be replayed with the checks
*.eval.log

# independent reviewer: the reviewer's configuration (.kiro), the bridge hooks (.claude) and the
# immutable review artifacts (.review-channel/reviews) are committed; only the runtime scratch
# (arm flags, bridge log, raw reviewer stdout) is not
.review-channel/runtime/
*.bak

.DS_Store
