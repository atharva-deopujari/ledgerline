# Copy to .env and fill in. Never commit .env.
# `docker compose up --build` reads this file via env_file.

# ---- required -------------------------------------------------------------

# OpenAI. https://platform.openai.com/api-keys
# Pay as you go. gpt-5.6-luna costs $0.20 in / $1.20 out per million tokens.
OPENAI_API_KEY=

# Daily (WebRTC audio + data channel). https://dashboard.daily.co -> Developers
# Free 10,000 participant-minutes/month. A card must be on file to enable usage.
DAILY_API_KEY=

# Deepgram (speech to text, and fallback text to speech). https://console.deepgram.com
# $200 free credit on signup, no card, does not expire.
DEEPGRAM_API_KEY=

# Cartesia (text to speech). https://play.cartesia.ai -> API Keys
# Free 20,000 credits/month, about 27 minutes of speech. Required unless TTS_PROVIDER=deepgram.
CARTESIA_API_KEY=

# ---- optional, defaults shown --------------------------------------------

# Exact model id. Bare "gpt-5.6" resolves to the expensive Sol tier; keep "-luna".
OPENAI_MODEL=gpt-5.6-luna

# cartesia | deepgram. Use deepgram during development to save Cartesia minutes.
TTS_PROVIDER=cartesia

# Cartesia voice id. Pick by ear; all three are Sonic 3.6 agent voices.
#   Janvi, steady Indian-English female, built for support (pair with CARTESIA_SPEED=1.05):
#     7ea5e9c2-b719-4dc3-b870-5ba5f14d31d8
#   Devansh, warm Indian-English male:  1259b7e3-cb8a-43df-9446-30971a46b8b0
#   Daniel, crisp US-English male (default): 47c38ca4-5f35-497b-b1a3-415245fb35e1
CARTESIA_VOICE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1
# Speaking rate, 0.6 to 1.5. Emotion is left unset; it only works well on a few named voices.
CARTESIA_SPEED=1.0

# smart | timeout. End-of-turn detection: Smart Turn v3 model, or a plain silence timeout.
TURN_STRATEGY=smart
SMART_TURN_STOP_SECS=1.5

# Which prompt version to run: v2 (identity, goal, money rules; plain-word tools) or v1 (the rule list and
# the old tools, kept until the after table is read). One setting switches prompt, tools and turn block.
PROMPT_VERSION=v2

# Daily room lifetime in seconds. Rooms self-clean at expiry.
ROOM_EXPIRY_SECS=3600

# Cancel a call after this many seconds with nobody speaking.
IDLE_TIMEOUT_SECS=300

# Free the call slot if the browser never joins the room within this many seconds.
JOIN_TIMEOUT_SECS=45

# After the bot says goodbye, hang up when it stops speaking, or after this many seconds.
END_GRACE_SECS=6

LOG_LEVEL=INFO

# ---- observability, memory, judge (all optional; empty means off) -----------

# Langfuse (tracing, prompt versions, judge scores). https://cloud.langfuse.com -> project -> API Keys
# Hobby plan is free: 50k units a month, 30 days retention. Presence of the keys turns tracing on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# production | development | simulation. Keeps test traces out of production dashboards.
LANGFUSE_ENVIRONMENT=development
# Only used to build the trace link shown on screen after a call.
LANGFUSE_PROJECT_ID=

# Postgres: who called, and the facts they stated, so the next call can start from them.
# docker compose sets this for the app container; for local runs point at the compose service.
DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5432/ledgerline
# Facts older than this are history, never carried into a call.
PROFILE_MAX_AGE_DAYS=60

# Where the console reads call recordings from. Empty means the repo's evals/runs, where the
# recorder writes them. A path here is read-only for the console; the recorder still writes evals/runs.
RECORDINGS_DIR=

# langfuse | file. Where the coach prompt is fetched from; the file is always the fallback.
PROMPT_SOURCE=langfuse

# Model for the end-of-call judge. Empty disables the intent layer; deterministic checks still run.
JUDGE_MODEL=
